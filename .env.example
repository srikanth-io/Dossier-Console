# Copy to .env.local and fill in values.
# Local dev values come from `npx supabase status` after `npm run db:start`.

# Local: http://127.0.0.1:54321 | Hosted: https://<project-ref>.supabase.co
VITE_SUPABASE_URL=

# Local: sb_publishable_... key from `npx supabase status`
# Hosted: Project Settings -> API Keys -> publishable (anon) key.
# NEVER put the secret/service_role key here - this app runs in the browser.
VITE_SUPABASE_PUBLISHABLE_KEY=
